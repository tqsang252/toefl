# ====================================================================
# TOEFL SMART 2026 - ENVIRONMENT VARIABLES
# ====================================================================

# 1. Google Gemini API Key (Dùng để AI tự động chấm điểm bài viết TOEFL Writing & Speaking)
# Lấy API Key miễn phí tại: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# 2. Groq Cloud API Key (Dùng Whisper Large v3 bóc tách giọng nói < 0.5s & Llama 3.3 siêu tốc)
# Lấy API Key miễn phí 100% tại: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# 3. OpenRouter API Key (Dự phòng khi Google Gemini bị quá tải hoặc hết quota)
# Lấy API Key tại: https://openrouter.ai/settings/keys
VITE_OPENROUTER_API_KEY=

# 4. Supabase Configuration (Tùy chọn - Dùng để lưu trữ bộ đề & từ vựng trên Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
