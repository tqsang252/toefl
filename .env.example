# ====================================================================
# TOEFL SMART 2026 - VERCEL & LOCAL ENVIRONMENT VARIABLES
# ====================================================================
# Hướng dẫn cấu hình khi deploy lên Vercel:
# 1. Truy cập Vercel Dashboard -> Chọn Project của bạn
# 2. Vào Settings -> Environment Variables
# 3. Thêm 2 biến môi trường dưới đây (chọn Production, Preview, Development):

# 1. URL của dự án Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Anon Public Key của Supabase (Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --------------------------------------------------------------------
# Lưu ý thêm: Nếu bạn dùng tính năng Vercel Integration kết nối trực tiếp
# với Supabase, Vercel sẽ tự sinh ra các biến SUPABASE_URL và SUPABASE_ANON_KEY.
# Ứng dụng đã được cấu hình tự động nhận diện cả 2 cách đặt tên trên!
