# 1. Dependencies (Thư viện cài đặt)
node_modules/
.pnp
.pnp.js

# 2. Build Outputs (Thư mục build khi chạy npm run build)
dist/
dist-ssr/
build/
out/

# 3. Environment Variables & Secret Keys (Bảo mật key Supabase / API)
